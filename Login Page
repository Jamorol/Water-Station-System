<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - AquaTrack</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f4ff;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        /* Water Drop Background Elements */
        .drop {
            position: absolute;
            background: linear-gradient(180deg, #d4e9ff 0%, #ffffff 100%);
            border-radius: 50% 50% 50% 50% / 15% 15% 85% 85%;
            filter: blur(2px);
            z-index: -1;
            opacity: 0.6;
        }

        .drop-top {
            width: 400px;
            height: 450px;
            top: -150px;
            right: -100px;
            transform: rotate(-15deg);
        }

        .drop-bottom {
            width: 300px;
            height: 350px;
            bottom: -100px;
            left: 50px;
            transform: rotate(10deg);
        }

        /* Main Card Styling */
        .signup-card {
            background-color: #0d2167; /* Deep Navy from image */
            width: 100%;
            max-width: 400px;
            padding: 3rem 2.5rem;
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(13, 33, 103, 0.25);
            z-index: 10;
        }

        .signup-title {
            color: white;
            font-size: 2rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 2.5rem;
            letter-spacing: -0.025em;
        }

        .input-field {
            width: 100%;
            padding: 0.85rem 1.25rem;
            border-radius: 0.6rem;
            border: none;
            margin-bottom: 1rem;
            font-weight: 500;
            outline: none;
            transition: all 0.2s ease;
        }

        .input-field::placeholder {
            color: #94a3b8;
        }

        .input-field:focus {
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.5);
        }

        .btn-primary {
            width: 100%;
            background-color: #1d63ed; /* Vibrant blue from image */
            color: white;
            padding: 0.85rem;
            border-radius: 0.6rem;
            font-weight: 700;
            margin-top: 0.5rem;
            transition: background-color 0.2s ease;
        }

        .btn-primary:hover {
            background-color: #1a56cc;
        }

        .divider-container {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: white;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background-color: rgba(255, 255, 255, 0.3);
        }

        .divider-text {
            padding: 0 1rem;
            font-size: 0.875rem;
            opacity: 0.8;
        }

        .btn-google {
            width: 100%;
            background-color: white;
            color: #0d2167;
            padding: 0.85rem;
            border-radius: 0.6rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            transition: background-color 0.2s ease;
        }

        .btn-google:hover {
            background-color: #f8fafc;
        }

        .google-icon {
            width: 18px;
            height: 18px;
        }
    </style>
</head>
<body>

    <!-- Background Drops -->
    <div class="drop drop-top"></div>
    <div class="drop drop-bottom"></div>

    <!-- Signup Card -->
    <div class="signup-card">
        <h1 class="signup-title">Create account</h1>
        
        <form onsubmit="event.preventDefault();">
            <input type="text" class="input-field" placeholder="Username" required>
            <input type="password" class="input-field" placeholder="Password" required>
            
            <button type="submit" class="btn-primary">
                Create account
            </button>
        </form>

        <div class="divider-container">
            <div class="divider-line"></div>
            <span class="divider-text">or</span>
            <div class="divider-line"></div>
        </div>

        <button class="btn-google">
            <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" class="google-icon">
            Sign up with Google
        </button>
    </div>

</body>
</html>
